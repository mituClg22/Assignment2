<!DOCTYPE html>

<html lang="en">

<head>

```
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Blog Dashboard</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
>

<style>

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', sans-serif;
        min-height: 100vh;

        background:
            radial-gradient(
                circle at top left,
                #7c3aed 0%,
                transparent 30%
            ),
            radial-gradient(
                circle at bottom right,
                #2563eb 0%,
                transparent 30%
            ),
            linear-gradient(
                135deg,
                #0f172a,
                #1e1b4b
            );

        color: white;
    }

    /* ================= HEADER ================= */

    .navbar {
        width: 100%;
        padding: 18px 6%;

        display: flex;
        align-items: center;
        justify-content: space-between;

        background: rgba(255, 255, 255, 0.07);
        backdrop-filter: blur(15px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);

        position: sticky;
        top: 0;
        z-index: 10;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 12px;

        font-size: 20px;
        font-weight: 800;
    }

    .logo-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;

        background: linear-gradient(
            135deg,
            #8b5cf6,
            #3b82f6
        );

        box-shadow:
            0 8px 20px rgba(99, 102, 241, 0.35);
    }

    .logout-btn {
        border: 1px solid rgba(255, 255, 255, 0.18);

        padding: 10px 18px;

        border-radius: 10px;

        background: rgba(255, 255, 255, 0.08);

        color: white;

        font-size: 13px;
        font-weight: 600;

        cursor: pointer;

        transition: 0.3s;
    }

    .logout-btn:hover {
        background: rgba(239, 68, 68, 0.2);
        border-color: rgba(239, 68, 68, 0.4);
        transform: translateY(-1px);
    }

    /* ================= MAIN ================= */

    .container {
        width: 90%;
        max-width: 1100px;

        margin: 0 auto;

        padding: 55px 0;
    }

    .welcome {
        margin-bottom: 35px;
    }

    .welcome h1 {
        font-size: 36px;
        font-weight: 800;

        margin-bottom: 8px;
    }

    .welcome p {
        color: #a5b4fc;
        font-size: 14px;
    }

    /* ================= POSTS GRID ================= */

    #posts {
        display: grid;

        grid-template-columns:
            repeat(auto-fit, minmax(300px, 1fr));

        gap: 25px;
    }

    /* ================= POST CARD ================= */

    .post {
        overflow: hidden;

        background: rgba(255, 255, 255, 0.08);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        border: 1px solid rgba(255, 255, 255, 0.13);

        border-radius: 20px;

        box-shadow:
            0 20px 40px rgba(0, 0, 0, 0.25);

        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;

        animation: cardAppear 0.5s ease;
    }

    .post:hover {
        transform: translateY(-6px);

        box-shadow:
            0 25px 50px rgba(0, 0, 0, 0.35);
    }

    @keyframes cardAppear {

        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }

    /* ================= IMAGE ================= */

    .post-image {
        width: 100%;
        height: 210px;

        object-fit: cover;

        display: block;

        background: rgba(255, 255, 255, 0.05);
    }

    .no-image {
        height: 160px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 45px;

        background:
            linear-gradient(
                135deg,
                rgba(139, 92, 246, 0.3),
                rgba(59, 130, 246, 0.2)
            );
    }

    /* ================= CONTENT ================= */

    .post-content {
        padding: 23px;
    }

    .post h2 {
        font-size: 20px;

        line-height: 1.4;

        margin-bottom: 12px;
    }

    .post-text {
        color: #cbd5e1;

        font-size: 14px;

        line-height: 1.7;

        margin-bottom: 18px;
    }

    /* ================= TAGS ================= */

    .tags {
        display: flex;

        flex-wrap: wrap;

        gap: 7px;

        margin-bottom: 20px;
    }

    .tag {
        padding: 6px 10px;

        border-radius: 20px;

        background: rgba(139, 92, 246, 0.15);

        border: 1px solid rgba(139, 92, 246, 0.25);

        color: #c4b5fd;

        font-size: 11px;

        font-weight: 600;
    }

    /* ================= BUTTONS ================= */

    .actions {
        display: flex;

        gap: 10px;
    }

    .delete-btn {
        flex: 1;

        padding: 11px;

        border: 1px solid rgba(239, 68, 68, 0.25);

        border-radius: 10px;

        background: rgba(239, 68, 68, 0.12);

        color: #fca5a5;

        font-weight: 600;

        cursor: pointer;

        transition: 0.3s;
    }

    .delete-btn:hover {
        background: rgba(239, 68, 68, 0.25);

        color: white;

        transform: translateY(-1px);
    }

    /* ================= EMPTY ================= */

    .empty {
        grid-column: 1 / -1;

        padding: 70px 20px;

        text-align: center;

        background: rgba(255, 255, 255, 0.07);

        border: 1px solid rgba(255, 255, 255, 0.12);

        border-radius: 20px;
    }

    .empty-icon {
        font-size: 50px;

        margin-bottom: 15px;
    }

    .empty h2 {
        margin-bottom: 8px;
    }

    .empty p {
        color: #94a3b8;

        font-size: 14px;
    }

    /* ================= LOADING ================= */

    .loading {
        text-align: center;

        padding: 80px 20px;

        color: #cbd5e1;
    }

    .spinner {
        width: 40px;
        height: 40px;

        margin: 0 auto 15px;

        border: 3px solid rgba(255,255,255,0.15);

        border-top-color: #8b5cf6;

        border-radius: 50%;

        animation: spin 0.8s linear infinite;
    }

    @keyframes spin {

        to {
            transform: rotate(360deg);
        }

    }

    /* ================= MOBILE ================= */

    @media (max-width: 600px) {

        .navbar {
            padding: 15px 5%;
        }

        .logo span {
            font-size: 16px;
        }

        .welcome h1 {
            font-size: 28px;
        }

        .container {
            width: 92%;

            padding: 35px 0;
        }

        #posts {
            grid-template-columns: 1fr;
        }

    }

</style>
```

</head>

<body>

```
<!-- ================= NAVBAR ================= -->

<nav class="navbar">

    <div class="logo">

        <div class="logo-icon">
            ✍️
        </div>

        <span>My Blog</span>

    </div>


    <button
        class="logout-btn"
        onclick="logout()"
    >
        Logout
    </button>

</nav>


<!-- ================= MAIN ================= -->

<main class="container">

    <div class="welcome">

        <h1>
            My Blog Dashboard
        </h1>

        <p>
            Manage and view all your blog posts
        </p>

    </div>


    <!-- POSTS -->

    <div id="posts">

        <div class="loading">

            <div class="spinner"></div>

            Loading your posts...

        </div>

    </div>

</main>
```

<script>


/* ================= LOAD POSTS ================= */

async function loadPosts() {

    const token =
        localStorage.getItem("token");


    // No token → Login

    if (!token) {

        window.location.href =
            "/login";

        return;

    }


    try {

        const response =
            await fetch(
                "/api/posts",
                {
                    headers: {
                        Authorization:
                            "Bearer " + token
                    }
                }
            );


        // Token invalid

        if (!response.ok) {

            localStorage.removeItem(
                "token"
            );

            window.location.href =
                "/login";

            return;

        }


        const data =
            await response.json();


        const container =
            document.getElementById(
                "posts"
            );


        /* No posts */

        if (
            !data.data ||
            data.data.length === 0
        ) {

            container.innerHTML = `

                <div class="empty">

                    <div class="empty-icon">
                        📝
                    </div>

                    <h2>
                        No Posts Yet
                    </h2>

                    <p>
                        You haven't created any blog posts yet.
                    </p>

                </div>

            `;

            return;

        }


        /* Display posts */

        container.innerHTML =
            data.data.map(post => {

                const image =
                    post.image
                    ? `
                        <img
                            src="${post.image}"
                            class="post-image"
                            alt="${post.title}"
                        >
                    `
                    : `
                        <div class="no-image">
                            📝
                        </div>
                    `;


                const tags =
                    post.tags &&
                    post.tags.length
                    ? post.tags.map(tag => `
                        <span class="tag">
                            #${tag}
                        </span>
                    `).join("")
                    : "";


                return `

                    <article class="post">

                        ${image}

                        <div class="post-content">

                            <h2>
                                ${post.title}
                            </h2>


                            <p class="post-text">
                                ${post.content}
                            </p>


                            <div class="tags">
                                ${tags}
                            </div>


                            <div class="actions">

                                <button
                                    class="delete-btn"
                                    onclick="deletePost('${post._id}')"
                                >
                                    🗑 Delete Post
                                </button>

                            </div>

                        </div>

                    </article>

                `;

            }).join("");

    }

    catch (error) {

        console.error(error);

        document.getElementById(
            "posts"
        ).innerHTML = `

            <div class="empty">

                <div class="empty-icon">
                    ⚠️
                </div>

                <h2>
                    Something went wrong
                </h2>

                <p>
                    Unable to load your posts.
                    Please try again.
                </p>

            </div>

        `;

    }

}


/* ================= DELETE POST ================= */

async function deletePost(id) {

    const confirmDelete =
        confirm(
            "Are you sure you want to delete this post?"
        );


    if (!confirmDelete) {
        return;
    }


    const token =
        localStorage.getItem("token");


    try {

        const response =
            await fetch(
                "/api/posts/" + id,
                {
                    method: "DELETE",

                    headers: {
                        Authorization:
                            "Bearer " + token
                    }
                }
            );


        const data =
            await response.json();


        alert(data.message);


        if (response.ok) {

            loadPosts();

        }

    }
    catch (error) {

        alert(
            "Unable to delete the post."
        );

    }

}


/* ================= LOGOUT ================= */

function logout() {

    localStorage.removeItem(
        "token"
    );

    window.location.href =
        "/login";

}


/* ================= START ================= */

loadPosts();

</script>

</body>

</html>
