<!DOCTYPE html>

<html lang="en">

<head>

```
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Published Blog Posts</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
>

<style>

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }


    /* ================= BODY ================= */

    body {

        font-family: 'Inter', sans-serif;

        min-height: 100vh;

        color: white;

        background:
            radial-gradient(
                circle at top left,
                #7c3aed 0%,
                transparent 30%
            ),
            radial-gradient(
                circle at bottom right,
                #2563eb 0%,
                transparent 30%
            ),
            linear-gradient(
                135deg,
                #0f172a,
                #1e1b4b
            );

    }


    /* ================= NAVBAR ================= */

    .navbar {

        width: 100%;

        padding: 18px 6%;

        display: flex;

        align-items: center;

        justify-content: space-between;

        background:
            rgba(255, 255, 255, 0.07);

        backdrop-filter: blur(15px);

        border-bottom:
            1px solid rgba(255, 255, 255, 0.12);

        position: sticky;

        top: 0;

        z-index: 10;

    }


    .logo {

        display: flex;

        align-items: center;

        gap: 12px;

        font-size: 20px;

        font-weight: 800;

    }


    .logo-icon {

        width: 42px;

        height: 42px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 12px;

        background:
            linear-gradient(
                135deg,
                #8b5cf6,
                #3b82f6
            );

        box-shadow:
            0 8px 20px
            rgba(99, 102, 241, 0.35);

    }


    .login-btn {

        padding: 10px 18px;

        border-radius: 10px;

        border:
            1px solid
            rgba(255, 255, 255, 0.18);

        background:
            rgba(255, 255, 255, 0.08);

        color: white;

        font-size: 13px;

        font-weight: 600;

        text-decoration: none;

        transition: 0.3s;

    }


    .login-btn:hover {

        background:
            rgba(139, 92, 246, 0.25);

        transform:
            translateY(-2px);

    }


    /* ================= MAIN ================= */

    .container {

        width: 90%;

        max-width: 1150px;

        margin: auto;

        padding: 55px 0;

    }


    .heading {

        text-align: center;

        margin-bottom: 45px;

    }


    .heading h1 {

        font-size: 38px;

        font-weight: 800;

        margin-bottom: 10px;

    }


    .heading p {

        color: #a5b4fc;

        font-size: 14px;

    }


    /* ================= POSTS GRID ================= */

    .posts-grid {

        display: grid;

        grid-template-columns:
            repeat(
                auto-fit,
                minmax(300px, 1fr)
            );

        gap: 28px;

    }


    /* ================= POST CARD ================= */

    .post {

        overflow: hidden;

        background:
            rgba(255, 255, 255, 0.08);

        backdrop-filter: blur(18px);

        -webkit-backdrop-filter: blur(18px);

        border:
            1px solid
            rgba(255, 255, 255, 0.13);

        border-radius: 20px;

        box-shadow:
            0 20px 40px
            rgba(0, 0, 0, 0.25);

        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;

        animation:
            appear 0.5s ease;

    }


    .post:hover {

        transform:
            translateY(-7px);

        box-shadow:
            0 28px 55px
            rgba(0, 0, 0, 0.35);

    }


    @keyframes appear {

        from {

            opacity: 0;

            transform:
                translateY(20px);

        }

        to {

            opacity: 1;

            transform:
                translateY(0);

        }

    }


    /* ================= IMAGE ================= */

    .image-container {

        position: relative;

        width: 100%;

        height: 220px;

        overflow: hidden;

    }


    .image-container img {

        width: 100%;

        height: 100%;

        object-fit: cover;

        display: block;

        transition:
            transform 0.5s ease;

    }


    .post:hover
    .image-container img {

        transform:
            scale(1.06);

    }


    .no-image {

        width: 100%;

        height: 220px;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 55px;

        background:
            linear-gradient(
                135deg,
                rgba(139, 92, 246, 0.3),
                rgba(59, 130, 246, 0.2)
            );

    }


    /* ================= CONTENT ================= */

    .post-content {

        padding: 24px;

    }


    .post h2 {

        font-size: 21px;

        line-height: 1.4;

        margin-bottom: 12px;

    }


    .post-text {

        color: #cbd5e1;

        font-size: 14px;

        line-height: 1.7;

        margin-bottom: 18px;

        display: -webkit-box;

        -webkit-line-clamp: 4;

        -webkit-box-orient: vertical;

        overflow: hidden;

    }


    /* ================= TAGS ================= */

    .tags {

        display: flex;

        flex-wrap: wrap;

        gap: 7px;

        margin-bottom: 20px;

    }


    .tag {

        padding: 6px 10px;

        border-radius: 20px;

        background:
            rgba(139, 92, 246, 0.15);

        border:
            1px solid
            rgba(139, 92, 246, 0.25);

        color: #c4b5fd;

        font-size: 11px;

        font-weight: 600;

    }


    /* ================= AUTHOR ================= */

    .author {

        display: flex;

        align-items: center;

        gap: 10px;

        padding-top: 15px;

        border-top:
            1px solid
            rgba(255, 255, 255, 0.1);

    }


    .author-icon {

        width: 34px;

        height: 34px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 50%;

        background:
            linear-gradient(
                135deg,
                #8b5cf6,
                #3b82f6
            );

        font-size: 15px;

    }


    .author-info {

        display: flex;

        flex-direction: column;

        gap: 3px;

    }


    .author-label {

        font-size: 10px;

        color: #94a3b8;

    }


    .author-name {

        font-size: 12px;

        font-weight: 600;

        color: #e2e8f0;

    }


    /* ================= EMPTY ================= */

    .empty {

        text-align: center;

        padding: 80px 20px;

        background:
            rgba(255, 255, 255, 0.07);

        border:
            1px solid
            rgba(255, 255, 255, 0.12);

        border-radius: 20px;

    }


    .empty-icon {

        font-size: 55px;

        margin-bottom: 15px;

    }

.delete-btn {
    /* width: 100%; */
    padding: 11px 15px;
margin-top: 10px;
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 10px;

    background: rgba(239, 68, 68, 0.12);
    color: #fca5a5;

    font-size: 13px;
    font-weight: 600;

    cursor: pointer;
    transition: all 0.3s ease;
}


.delete-btn:hover {
    background: rgba(239, 68, 68, 0.25);
    color: white;
    transform: translateY(-2px);
}
    .empty h2 {

        margin-bottom: 8px;

    }


    .empty p {

        color: #94a3b8;

        font-size: 14px;

    }


    /* ================= MOBILE ================= */

    @media (max-width: 600px) {

        .navbar {

            padding: 15px 5%;

        }


        .logo span {

            font-size: 16px;

        }
        .post-actions {
    margin-top: 20px;
}



        .container {

            width: 92%;

            padding: 35px 0;

        }


        .heading h1 {

            font-size: 29px;

        }


        .posts-grid {

            grid-template-columns: 1fr;

        }

    }

</style>
```

</head>

<body>

```
<!-- ================= NAVBAR ================= -->

<nav class="navbar">

    <div class="logo">

        <div class="logo-icon">
            ✍️
        </div>

        <span>My Blog</span>

    </div>


    <a
        href="/login"
        class="login-btn"
    >
        🔐 Login
    </a>

</nav>


<!-- ================= MAIN ================= -->

<main class="container">


    <div class="heading">

        <h1>
            ✨ Published Stories
        </h1>

        <p>
            Explore the latest stories from our blog community
        </p>

    </div>


    <% if (posts.length === 0) { %>


        <div class="empty">

            <div class="empty-icon">
                📝
            </div>

            <h2>
                No Published Posts
            </h2>

            <p>
                There are no published blog posts available yet.
            </p>

        </div>


    <% } else { %>


        <div class="posts-grid">


            <% posts.forEach(post => { %>


                <article class="post">


                    <!-- IMAGE -->

                    <div class="image-container">


                        <% if (post.image) { %>


                            <img
                                src="<%= post.image %>"
                                alt="<%= post.title %>"
                            >


                        <% } else { %>


                            <div class="no-image">
                                📝
                            </div>


                        <% } %>


                    </div>


                    <!-- CONTENT -->

                    <div class="post-content">


                        <h2>
                            <%= post.title %>
                        </h2>


                        <p class="post-text">

                            <%= post.content %>

                        </p>


                        <!-- TAGS -->

                        <% if (post.tags && post.tags.length > 0) { %>


                            <div class="tags">


                                <% post.tags.forEach(tag => { %>


                                    <span class="tag">
                                        #<%= tag %>
                                    </span>


                                <% }) %>


                            </div>


                        <% } %>


                        <!-- AUTHOR -->

                        <div class="author">


                            <div class="author-icon">
                                👤
                            </div>


                            <div class="author-info">

                                <span class="author-label">
                                    Published by
                                </span>

                                <span class="author-name">

                                    <%= post.author.name %>

                                </span>

                            </div>


                        </div>
<div class="post-actions">

    <button
        class="delete-btn"
        onclick="deletePost('<%= post._id %>')"
    >
        🗑️ Delete Post
    </button>

</div>

                    </div>


                </article>


            <% }) %>


        </div>


    <% } %>


</main>
```
<script>

async function deletePost(id) {

    const confirmDelete = confirm(
        "Are you sure you want to delete this post?"
    );

    if (!confirmDelete) {
        return;
    }

    const token = localStorage.getItem("token");

    // User must be logged in
    if (!token) {
        alert("Please login first.");
        window.location.href = "/login";
        return;
    }

    try {

        const response = await fetch(
            "/api/posts/" + id,
            {
                method: "DELETE",

                headers: {
                    "Authorization": "Bearer " + token
                }
            }
        );

        const data = await response.json();

        if (response.ok) {

            alert("✅ " + data.message);

            // Refresh page after deletion
            window.location.reload();

        } else {

            alert(
                "❌ " +
                (data.message || "Unable to delete post")
            );

        }

    } catch (error) {

        console.error(error);

        alert(
            "❌ Server error. Please try again."
        );

    }

}

</script>

</body>

</html>
